        <mxCell id="8KbKPri9f_MpzoByaB8M-235" value="&lt;div style=&quot;color: rgb(188, 190, 196);&quot;&gt;&lt;pre style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace;&quot;&gt;&lt;span style=&quot;color: rgb(207, 142, 109);&quot;&gt; public&lt;/span&gt;&lt;font color=&quot;#bcbec4&quot;&gt; &lt;/font&gt;&lt;span style=&quot;color: rgb(207, 142, 109);&quot;&gt;int &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 168, 245);&quot;&gt;find&lt;/span&gt;&lt;font color=&quot;#bcbec4&quot;&gt;(arr[] array, &lt;/font&gt;&lt;font color=&quot;#16baac&quot;&gt;int &lt;/font&gt;&lt;font color=&quot;#bcbec4&quot;&gt;key) { &lt;br&gt;    &lt;/font&gt;&lt;span style=&quot;color: rgb(207, 142, 109);&quot;&gt;int &lt;/span&gt;&lt;font color=&quot;#bcbec4&quot;&gt;left = &lt;/font&gt;&lt;span style=&quot;color: rgb(42, 172, 184);&quot;&gt;0&lt;/span&gt;&lt;font color=&quot;#bcbec4&quot;&gt;;&lt;br&gt;    &lt;/font&gt;&lt;span style=&quot;color: rgb(207, 142, 109);&quot;&gt;int &lt;/span&gt;&lt;font color=&quot;#bcbec4&quot;&gt;right = array.&lt;/font&gt;&lt;span style=&quot;color: rgb(199, 125, 187);&quot;&gt;length &lt;/span&gt;&lt;font color=&quot;#bcbec4&quot;&gt;- &lt;/font&gt;&lt;span style=&quot;color: rgb(42, 172, 184);&quot;&gt;1&lt;/span&gt;&lt;font color=&quot;#bcbec4&quot;&gt;;&lt;/font&gt;&lt;/pre&gt;&lt;pre style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace;&quot;&gt;&lt;span style=&quot;color: rgb(188, 190, 196);&quot;&gt;&lt;br&gt;    &lt;span style=&quot;color:#cf8e6d;&quot;&gt;while &lt;/span&gt;(left &amp;lt; right) {&lt;br&gt;        &lt;span style=&quot;color:#cf8e6d;&quot;&gt;int &lt;/span&gt;mid = (left + right) / &lt;span style=&quot;color:#2aacb8;&quot;&gt;2&lt;/span&gt;;&lt;br&gt;        &lt;span style=&quot;color:#cf8e6d;&quot;&gt;if &lt;/span&gt;(array[mid] == key) {&lt;br&gt;            &lt;span style=&quot;color:#cf8e6d;&quot;&gt;return &lt;/span&gt;mid;&lt;br&gt;        }&lt;br&gt;        &lt;span style=&quot;color:#cf8e6d;&quot;&gt;if &lt;/span&gt;(array[mid] &amp;lt; &lt;/span&gt;&lt;font color=&quot;#2aacb8&quot;&gt;key&lt;/font&gt;&lt;font color=&quot;#bcbec4&quot;&gt;) {&lt;br&gt;            left = mid + &lt;/font&gt;&lt;span style=&quot;color: rgb(42, 172, 184);&quot;&gt;1&lt;/span&gt;&lt;font color=&quot;#bcbec4&quot;&gt;;&lt;br&gt;        } &lt;/font&gt;&lt;span style=&quot;color: rgb(207, 142, 109);&quot;&gt;else &lt;/span&gt;&lt;font color=&quot;#bcbec4&quot;&gt;{&lt;br&gt;            right = mid;&lt;br&gt;        }&lt;br&gt;    }&lt;br&gt;&lt;br&gt;    &lt;/font&gt;&lt;span style=&quot;color: rgb(207, 142, 109);&quot;&gt;if &lt;/span&gt;&lt;font color=&quot;#bcbec4&quot;&gt;(left == right) &lt;/font&gt;&lt;span style=&quot;color: rgb(207, 142, 109);&quot;&gt;return &lt;/span&gt;&lt;font color=&quot;#bcbec4&quot;&gt;left;&lt;br&gt;    &lt;/font&gt;&lt;span style=&quot;color: rgb(207, 142, 109);&quot;&gt;return &lt;/span&gt;&lt;font color=&quot;#bcbec4&quot;&gt;-&lt;/font&gt;&lt;span style=&quot;color: rgb(42, 172, 184);&quot;&gt;1&lt;/span&gt;&lt;font color=&quot;#bcbec4&quot;&gt;;&lt;br&gt; }&lt;/font&gt;&lt;/pre&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;labelBorderColor=none;labelBackgroundColor=default;fontSize=13;" parent="cTwWQHFEF-Gsk3b4i1Hn-31" vertex="1">
